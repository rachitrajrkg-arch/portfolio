DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# The passcode typed into /admin. Change this to your own value.
ADMIN_PASSCODE=change-me

# Random secret used to sign the admin session cookie. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_TOKEN=change-me-too

# Used by src/app/sitemap.ts to build absolute URLs. Optional — falls back to
# Vercel's auto-populated VERCEL_URL, then localhost, if unset.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
